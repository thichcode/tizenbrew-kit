{
  "name": "tizenbrew-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for building lightweight TizenBrew-compatible modules",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @tizenbrew-kit/cli dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=2.1.4",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "esbuild": ">=0.28.1",
      "undici": ">=7.29.0",
      "sharp": ">=0.35.0"
    }
  }
}
